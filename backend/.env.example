# Groq API key. Required for AI explanations. Never commit a real key.
LLM_API_KEY=

# OpenAI-compatible chat completions base URL. Defaults to Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Chat model used to rank the shortlist and write reasons.
# openai/gpt-oss-120b supports Groq strict JSON schema.
# Calls use low reasoning effort and a 512-token output cap for the 8K tokens/minute limit.
LLM_MODEL=openai/gpt-oss-120b

# Path to the prepared restaurant catalog (parquet).
CATALOG_PATH=data/restaurants.parquet

# Seconds to wait for the model response before falling back.
LLM_TIMEOUT_SECONDS=20

# Comma-separated browser origins allowed to call the API, in addition to the Vite dev servers.
# Leave unset locally. On Railway, set the Vercel site origin with no path.
# CORS_ORIGINS=https://your-app.vercel.app
